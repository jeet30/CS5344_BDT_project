\@writefile{toc}{\contentsline {section}{\numberline {6}Lessons Learned}{10}{section.6}\protected@file@percent }
\newlabel{sec:lessons}{{6}{10}{Lessons Learned}{section.6}{}}
\@writefile{toc}{\contentsline {paragraph}{1. Shape the data for the detector, not for fidelity.}{10}{section*.18}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{2. Dataset structure determines which transformations are useful.}{10}{section*.19}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{3. Local models require sufficient support and regularization.}{10}{section*.20}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{4. Proxy validation can mis-rank promising changes.}{10}{section*.21}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{5. Change one thing at a time.}{10}{section*.22}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{6. Check intuitive explanations with a direct test.}{10}{section*.23}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Conclusion and Future Work}{10}{section.7}\protected@file@percent }
