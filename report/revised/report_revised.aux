\@writefile{toc}{\contentsline {section}{\numberline {6}Lessons Learned and Research Limitations}{10}{section.6}\protected@file@percent }
\newlabel{sec:lessons}{{6}{10}{Lessons Learned and Research Limitations}{section.6}{}}
\@writefile{toc}{\contentsline {paragraph}{1. Downstream utility and distribution fidelity are distinct objectives.}{10}{section*.17}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{2. Dataset structure determines which transformations are useful.}{10}{section*.18}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{3. Local models require sufficient support and regularization.}{10}{section*.19}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{4. Proxy validation can mis-rank apparently promising changes.}{10}{section*.20}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{5. Small gains require uncertainty estimates and matched comparisons.}{10}{section*.21}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{6. Causal explanations require targeted ablations.}{10}{section*.22}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Conclusion and Future Work}{10}{section.7}\protected@file@percent }
